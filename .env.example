# ───────────── Core ─────────────
# Public base URL of this deployment (no trailing slash). Used in emails, signed links,
# Stripe redirect URLs and the "links" of every API response.
PUBLIC_URL=https://pay.example.com
# At least 32 random characters. Encrypts secrets at rest and signs URLs/cookies.
# Changing it invalidates stored secrets and signed links. Generate: openssl rand -hex 32
APP_SECRET=
APP_ENV=production

# ───────────── Database ─────────────
# PostgreSQL (recommended) or SQLite for single-node setups: sqlite:./data/fulfillment.db
DATABASE_URL=postgres://fulfillment:change-me@postgres:5432/fulfillment?sslmode=disable
POSTGRES_PASSWORD=change-me

# ───────────── First admin (optional) ─────────────
# Without these the first start prints a one-time setup token to the log; open /admin to finish setup.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ───────────── Stripe ─────────────
# All of these can also be set in the admin UI (Settings → Stripe); UI values win.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Pin the Stripe API version used for outgoing calls.
STRIPE_API_VERSION=2025-09-30.clover
# Create Checkout Sessions with managed_payments[enabled]=true (Stripe Managed Payments).
STRIPE_MANAGED_PAYMENTS=false

# "Sign in with Stripe" (Connect OAuth). Needs a Stripe Connect platform; register
#   {PUBLIC_URL}/admin-api/auth/stripe/callback
# as a redirect URI in Stripe → Connect → OAuth settings.
STRIPE_OAUTH_CLIENT_ID=
# Platform secret key used for the code exchange (defaults to STRIPE_SECRET_KEY).
STRIPE_OAUTH_SECRET_KEY=
# allowlist: only linked accounts / ADMIN_STRIPE_ACCOUNTS may sign in. auto: also accounts set on a store.
STRIPE_LOGIN_MODE=allowlist
ADMIN_STRIPE_ACCOUNTS=
STRIPE_LOGIN_AUTO_ROLE=viewer
# Revoke the platform's access right after login (we only need the identity).
STRIPE_OAUTH_REVOKE_AFTER_LOGIN=true

# ───────────── File storage ─────────────
STORAGE_DRIVER=local
DATA_DIR=/data
# S3 compatible (set STORAGE_DRIVER=s3):
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=true
S3_PATH_STYLE=false
S3_PREFIX=files
MAX_UPLOAD_MB=1024

# ───────────── Email (SMTP) ─────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Your Store <orders@example.com>"
# starttls | tls | none
SMTP_SECURITY=starttls

# ───────────── Behaviour ─────────────
LICENSE_RATE_LIMIT=60          # License API requests / minute / IP (same as Lemon Squeezy)
API_RATE_LIMIT=300             # JSON:API requests / minute / key
DOWNLOAD_LIMIT_PER_DAY=10      # per file and IP
DOWNLOAD_URL_TTL_SECONDS=3600
DISABLE_LICENSE_ON_REFUND=true
WEBHOOK_MAX_ATTEMPTS=4         # first try + retries after 5s, 25s, 125s
# Set true only behind a reverse proxy you control (reads X-Forwarded-For for IP limits).
TRUST_PROXY_HEADERS=false

# ───────────── Frontend container ─────────────
# The Next.js image proxies /admin-api, /v1, /download, /webhooks … to the Go API. The destination is
# baked in at *build* time (docker-compose.yml → frontend.build.args.BACKEND_URL, default http://backend:8080).
