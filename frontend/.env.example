# Where the Go backend lives. Used by the Next.js server to proxy
# /admin-api, /storefront-api, /v1, /download, /billing, /checkout, /webhooks, /healthz.
# NOTE: Next.js evaluates rewrites at BUILD time (they are baked into
# .next/routes-manifest.json), so set BACKEND_URL when running `next build`
# (docker: --build-arg BACKEND_URL=...). Changing it later requires a rebuild.
BACKEND_URL=http://localhost:8080
